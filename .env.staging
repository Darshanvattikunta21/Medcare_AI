# Staging Environment Configuration
APP_ENV=staging
PORT=4000
NODE_ENV=production

# API Configuration
PERSISTENCE_PROVIDER=database
DATABASE_URL=postgresql://medicare:replace-me@postgres:5432/medicare_ai?schema=public
API_DATA_FILE=/app/data/db.json
PRESCRIPTION_UPLOAD_DIR=/app/storage/prescriptions
CORS_ORIGIN=https://staging.medicareai.com,https://staging-app.medicareai.com
AUTH_SECRET=replace-with-a-long-random-secret

# Web App
NEXT_PUBLIC_API_BASE_URL=https://staging-api.medicareai.com

# Mobile App
EXPO_PUBLIC_API_BASE_URL=https://staging-api.medicareai.com

# API Service
API_BASE_URL=https://staging-api.medicareai.com
